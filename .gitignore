node_modules/
dist/
build/
coverage/
.venv/
.env
.env.*
!.env.example
*.log
.DS_Store
.runtime/
data/
pgdata/
orthanc-db/
*.sqlite
*.pid
tmp/

# Generated by scripts/validation/make-study-files.py and by the inbox drain. They
# are synthetic images, but they are also bytes an operator can always rebuild, so
# they do not belong in history.
scripts/validation/out/
scripts/validation/out-*/
.tmp-inbox/
# Storage for the throwaway Orthanc container the verification runs against. It holds
# instance files, and a scratch directory that can accumulate patient data one day must
# never be a `git add -A` away from history.
.tmp-orth/

# Backup artifacts from scripts/backup/backup.sh. The database dump is real PHI
# by definition, so the whole directory stays out of history and out of the
# cloud; copies belong on offline media, never in git.
backups/

# Python bytecode from the validation scripts importing each other.
__pycache__/
