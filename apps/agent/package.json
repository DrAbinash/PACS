{
  "name": "@telrad/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:exe": "pnpm build && pkg . --out-path dist-exe --targets node18-win-x64",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@telrad/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [],
    "targets": ["node18-win-x64"],
    "outputPath": "dist-exe"
  }
}
