@echo off
setlocal EnableDelayedExpansion

echo ============================================
echo   telrad Agent Installer
echo ============================================
echo.
echo This will install the telrad upload agent on this computer.
echo The agent watches a folder and uploads DICOM studies to your PACS.
echo.
pause

REM Check for admin rights
net session >nul 2>&1
if %errorLevel% neq 0 (
    echo ERROR: This installer must be run as Administrator.
    echo Right-click this file and select "Run as administrator".
    pause
    exit /b 1
)

echo.
echo Step 1: Installation folder
echo ---------------------------
set "INSTALL_DIR=C:\Program Files\telrad-agent"
set /p "INSTALL_DIR=Install to [default: C:\Program Files\telrad-agent]: "
if "!INSTALL_DIR!"=="" set "INSTALL_DIR=C:\Program Files\telrad-agent"

echo.
echo Step 2: API URL
echo ---------------------------
set "API_URL=https://pacs.caredeoghar.com"
set /p "API_URL=API URL [default: https://pacs.caredeoghar.com]: "
if "!API_URL!"=="" set "API_URL=https://pacs.caredeoghar.com"

echo.
echo Step 3: Site token
echo ---------------------------
echo Get your token from the telrad console: Admin > Imaging sites > Manage tokens
set /p "SITE_TOKEN=Enter your site token: "
if "!SITE_TOKEN!"=="" (
    echo ERROR: Token is required.
    pause
    exit /b 1
)

echo.
echo Step 4: Watch folder
echo ---------------------------
echo This is the folder your MRI/CT exports DICOM files to.
set "WATCH_DIR=C:\telrad-export"
set /p "WATCH_DIR=Watch folder [default: C:\telrad-export]: "
if "!WATCH_DIR!"=="" set "WATCH_DIR=C:\telrad-export"

echo.
echo Step 5: Hints (optional)
echo ---------------------------
echo If your folder names contain accession numbers, enter the pattern.
echo Example: {accession}-{date} for folders like "ACC123-20261014"
set "HINTS="
set /p "HINTS=Hints pattern (leave blank if unsure): "

echo.
echo Installing...
echo.

REM Create installation directory
if not exist "!INSTALL_DIR!" mkdir "!INSTALL_DIR!"

REM Copy the agent executable
copy /Y "%~dp0agent.exe" "!INSTALL_DIR!\telrad-agent.exe" >nul

REM Create config directory
if not exist "!INSTALL_DIR!\config" mkdir "!INSTALL_DIR!\config"

REM Save token to config file (mode 600 equivalent - restrict access)
echo !SITE_TOKEN! > "!INSTALL_DIR!\config\token.txt"
icacls "!INSTALL_DIR!\config\token.txt" /inheritance:r /grant:r "%USERNAME%":R >nul 2>&1

REM Create configuration file
(
echo # telrad agent configuration
echo # Generated by installer on %DATE% %TIME%
echo API_URL=!API_URL!
echo WATCH_DIR=!WATCH_DIR!
echo TOKEN_FILE=!INSTALL_DIR!\config\token.txt
echo STATE_FILE=!WATCH_DIR!\.telrad-state.json
if not "!HINTS!"=="" echo HINTS=!HINTS!
echo INTERVAL=20
echo SETTLE=30
) > "!INSTALL_DIR!\config\agent.conf"

REM Create watch folder if it doesn't exist
if not exist "!WATCH_DIR!" mkdir "!WATCH_DIR!"

REM Create startup script
(
echo @echo off
echo cd /d "!INSTALL_DIR!"
echo telrad-agent.exe --watch "!WATCH_DIR!" --api !API_URL! --token-file "!INSTALL_DIR!\config\token.txt"!HINTS: =! --interval 20 --settle 30
) > "!INSTALL_DIR!\start-agent.bat"

REM Create Windows startup shortcut
set "STARTUP_DIR=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup"
set "SHORTCUT_PATH=!STARTUP_DIR!\telrad-agent.lnk"

REM Use PowerShell to create shortcut
powershell -Command "$WshShell = New-Object -ComObject WScript.Shell; $Shortcut = $WshShell.CreateShortcut('!SHORTCUT_PATH!'); $Shortcut.TargetPath = '!INSTALL_DIR!\start-agent.bat'; $Shortcut.WorkingDirectory = '!INSTALL_DIR!'; $Shortcut.Description = 'telrad upload agent'; $Shortcut.Save()"

REM Create uninstaller
(
echo @echo off
echo echo Uninstalling telrad agent...
echo.
echo stop /y telrad-agent 2^>nul
echo.
echo Removing startup shortcut...
echo del "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\telrad-agent.lnk" 2^>nul
echo.
echo Removing installation folder...
echo rmdir /s /q "!INSTALL_DIR!"
echo.
echo Uninstall complete.
echo pause
) > "!INSTALL_DIR!\uninstall.bat"

echo.
echo ============================================
echo   Installation complete!
echo ============================================
echo.
echo Installed to: !INSTALL_DIR!
echo Watch folder: !WATCH_DIR!
echo API URL:      !API_URL!
echo.
echo The agent will start automatically when you log in.
echo To start it now, run: !INSTALL_DIR!\start-agent.bat
echo.
echo To uninstall, run:    !INSTALL_DIR!\uninstall.bat
echo.
echo IMPORTANT: Copy DICOM files to !WATCH_DIR! to begin uploading.
echo.
pause
