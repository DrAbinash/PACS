# Copy to .env and replace every <generated: ...> value. Never commit .env.
# `scripts/doctor/check-secrets.sh` refuses to start the stack on a placeholder.

TR_RUNTIME=/volume1/docker/telrad/runtime
TR_RELEASE=dev

# Postgres
TR_DB_NAME=telrad
TR_DB_USER=telrad
TR_DB_PASSWORD=<generated: openssl rand -base64 24>

# Orthanc, pinned by image digest. The digest below is the container this
# repository's ingest contract was verified against — `GET /system` on it answers
# Version 1.13.0. Do not put a version here instead: orthancteam/orthanc publishes
# CalVer tags (26.9.1, latest) and "1.13.0" is not one of them, so a tag-shaped
# value fails the first pull. Check any new digest before deploying:
#   docker manifest inspect orthancteam/orthanc@<digest>
ORTHANC_IMAGE_DIGEST=sha256:d2705f2c56547e55ce9bc2250fd22d05d326493b3f3d9fa191ecb7db8ca6b5a2
# The image creates this username from ORTHANC_PASSWORD; it is not configurable.
TR_ORTHANC_USER=orthanc
TR_ORTHANC_PASSWORD=<generated: openssl rand -base64 24>

# Host ports. Re-measure before choosing: 5690/8443 avoid the owner's existing
# stack (5680, 8042, 3010, 8888, 187, 5000/5001, 11434).
TR_DICOM_PORT=5690
TR_HTTPS_PORT=8443

# api
TR_SESSION_SECRET=<generated: openssl rand -base64 48>
TR_UPLOAD_SIGNING_SECRET=<generated: openssl rand -base64 32>
TR_PUBLIC_URL=https://telrad.<your-domain>:8443
TR_LOG_LEVEL=info

# worker
TR_WORKER_POLL_SECONDS=10
