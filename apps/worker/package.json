{
  "name": "@telrad/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "once": "tsx src/main.ts once",
    "dispatch-once": "tsx src/main.ts dispatch-once",
    "criticals-once": "tsx src/main.ts criticals-once",
    "review-once": "tsx src/main.ts review-once",
    "notify-once": "tsx src/main.ts notify-once",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@telrad/db": "workspace:*",
    "@telrad/shared": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fflate": "^0.8.2",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
