# Copy to .env and replace every <generated: ...> value. Never commit .env.
# `scripts/doctor/check-secrets.sh` refuses to start the stack on a placeholder.

TR_RUNTIME=/volume1/docker/telrad/runtime
TR_RELEASE=dev

# Postgres
TR_DB_NAME=telrad
TR_DB_USER=telrad
TR_DB_PASSWORD=<generated: openssl rand -base64 24>

# Orthanc, pinned by image digest. The digest below is the container this
# repository's ingest contract was verified against — `GET /system` on it answers
# Version 1.13.0. Do not put a version here instead: orthancteam/orthanc publishes
# CalVer tags (26.9.1, latest) and "1.13.0" is not one of them, so a tag-shaped
# value fails the first pull. Check any new digest before deploying:
#   docker manifest inspect orthancteam/orthanc@<digest>
ORTHANC_IMAGE_DIGEST=sha256:d2705f2c56547e55ce9bc2250fd22d05d326493b3f3d9fa191ecb7db8ca6b5a2
# The image creates this username from ORTHANC_PASSWORD; it is not configurable.
TR_ORTHANC_USER=orthanc
TR_ORTHANC_PASSWORD=<generated: openssl rand -base64 24>
# Caddy attaches this as the Authorization header when proxying /dicom-web/*, so
# the image plane never sees an anonymous request. It must be exactly
# base64("orthanc:" + TR_ORTHANC_PASSWORD) or the proxy authenticates against
# nothing — check-secrets.sh verifies the pair, so generate both together:
#   printf 'orthanc:%s' "$TR_ORTHANC_PASSWORD" | base64
TR_ORTHANC_BASIC_B64=<generated: printf 'orthanc:%s' "$TR_ORTHANC_PASSWORD" | base64>

# Host ports. Re-measure before choosing: 5690/8443 avoid the owner's existing
# stack (5680, 8042, 3010, 8888, 187, 5000/5001, 11434).
TR_DICOM_PORT=5690
TR_HTTPS_PORT=8443
# The name the browser uses to reach this deployment. Caddy issues its internal
# certificate for exactly this name, so an IP address cannot work — an IP URL
# sends no SNI for the certificate to match. It must resolve to this host
# (DNS or hosts entry) and match TR_PUBLIC_URL; check-config.sh warns on drift.
# Default `localhost` makes a local proof-of-boot work with nothing else.
TR_TLS_HOSTNAME=localhost

# api
TR_SESSION_SECRET=<generated: openssl rand -base64 48>
TR_UPLOAD_SIGNING_SECRET=<generated: openssl rand -base64 32>
TR_PUBLIC_URL=https://telrad.<your-domain>:8443
TR_LOG_LEVEL=info
# Leave unset on a bare host (the code defaults to loopback); compose sets this
# to 0.0.0.0 because the api container must answer its neighbor, Caddy.
#TR_BIND_HOST=0.0.0.0

# worker
TR_WORKER_POLL_SECONDS=10

# notification outbox — both or neither
# Empty means nothing is sent and nothing is lost: released reports queue a `pending` notice,
# the worker boots saying it has no relay, and the notices stay on the board until somebody
# configures one. Half a configuration is the dangerous case — a URL with no from-address, or a
# from-address with no public origin to put in the message — so the sweep refuses to send at all
# rather than sending something a clinic cannot act on.
# A relay that requires a password puts it in the URL, which makes TR_SMTP_URL a secret: never
# commit it, and never echo it into a log or an audit row (the worker records the hostname only).
TR_SMTP_URL=
TR_SMTP_FROM=
# The ops digest: one address that receives the sweeps' alert rows (exhausted dispatch, SLA
# breach, unacknowledged criticals, reports waiting for a second name, dead or refused
# notifications) on a bounded cadence instead of one mail per alert. Empty keeps alerts
# audit-only; the worker boots saying so. The digest prints audit detail through a fixed key
# whitelist, so it cannot carry a patient name even if a sweep writes one.
TR_OPS_EMAIL=
TR_OPS_DIGEST_MINUTES=5
# The WhatsApp channel (Meta Cloud API). Dormant until all three are filled in: whatsapp
# notification rows queue when a report is delivered, and wait until the credentials arrive —
# no code changes on the day the API is granted. TR_WHATSAPP_TEMPLATE must name the template
# approved in Meta Business Manager whose body placeholders appear in this order: centre name,
# referral accession, report version, portal URL (see packages/shared/src/whatsapp.ts).
# The token is a secret: it goes in .env only, never committed.
TR_WHATSAPP_TOKEN=
TR_WHATSAPP_PHONE_ID=
TR_WHATSAPP_TEMPLATE=
TR_WHATSAPP_LANGUAGE=en
