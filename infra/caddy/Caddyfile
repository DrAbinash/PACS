{
	admin off
	# disable_redirects, not off: plain `off` disables certificate management
	# entirely, and then `tls internal` provisions nothing — every handshake
	# dies with a TLS alert while the logs stay silent about why (measured).
	# Redirects stay disabled so Caddy never binds port 80.
	auto_https disable_redirects
	servers {
		trusted_proxies static private_ranges
	}
}

# The NAS target cannot bind 443 because DSM and Web Station own it, so this
# deployment serves on 8443 with Caddy's internal CA. The cloud target binds 443
# and replaces `tls internal` with a real DNS challenge.
#
# The site address carries a hostname, not just a port: a bare `:8443` gives
# Caddy no name to certify, and a plain IP cannot work either, because an IP
# URL sends no SNI. TR_TLS_HOSTNAME is the name centers type into their
# browser; it must resolve to this host and match TR_PUBLIC_URL.
{$TR_TLS_HOSTNAME:localhost}:8443 {
	tls internal

	# No /dicom-web/* route here. It used to proxy to Orthanc with an injected admin
	# credential and no session check — any visitor of this site could reach the whole
	# node (QIDO, retrieve, even C-STORE) across every tenant, because WADO URLs carry
	# node UIDs that the api's per-case authorization cannot see. Nothing in apps/
	# consumed it, so it is gone. The DICOMweb plugin stays enabled inside the docker
	# network, where Orthanc's own authentication applies, and pixels reach the viewer
	# only through /v1/view/*, which authorizes per case.

	handle_path /api/* {
		uri strip_prefix /api
		reverse_proxy tr-api:3001
	}

	# The console calls /v1 on its own origin, because the session cookie is
	# SameSite=Strict. Note `handle`, not `handle_path`: the api's routes already
	# carry /v1, so stripping it here would 404 every call.
	handle /v1/* {
		reverse_proxy tr-api:3001
	}

	handle /health/* {
		reverse_proxy tr-api:3001
	}

	handle {
		# apps/web/dist, bind-mounted read-only. A missing build answers 404 rather
		# than silently falling back to the api, which is what this line used to do.
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}
}
